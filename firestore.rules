rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Movies collection
    match /movies/{movieId} {
      allow read: if true;
      allow write: if true; // Allows reviews, dynamic ratings, and core movie configurations
    }
  }
}
